{
	"name": "@clearsoft/easysql-cli",
	"version": "0.1.0",
	"description": "EasySQL CLI/TUI — run natural-language queries against your local MySQL or PostgreSQL database using the EasySQL API.",
	"type": "module",
	"bin": {
		"easysql": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"scripts": {
		"dev": "bun run src/cli.ts",
		"build": "bun run scripts/build.ts",
		"build:compile": "bun run scripts/build.ts --compile",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "biome check . && tsc --noEmit"
	},
	"dependencies": {
		"@clearsoft/easysql-sdk": "^1.0.0",
		"chalk": "^5.3.0",
		"commander": "^12.1.0",
		"mysql2": "^3.11.5",
		"openapi-fetch": "^0.13.0",
		"pg": "^8.13.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/node": "^22.10.0",
		"@types/pg": "^8.11.10",
		"@types/semver": "^7.5.8",
		"semver": "^7.6.3",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	},
	"engines": {
		"bun": ">=1.1.0",
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Clearsoft-net/easysql-cli.git"
	},
	"bugs": {
		"url": "https://github.com/Clearsoft-net/easysql-cli/issues"
	},
	"homepage": "https://easysql.net",
	"keywords": [
		"easysql",
		"clearsoft",
		"cli",
		"tui",
		"sql",
		"nlp",
		"ai",
		"mysql",
		"postgres",
		"postgresql"
	],
	"license": "MIT"
}
